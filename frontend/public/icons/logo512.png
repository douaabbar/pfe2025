<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <!-- Circle background -->
  <circle cx="50" cy="50" r="45" fill="#2563eb" />
  
  <!-- Heart pulse line -->
  <path d="M20,50 L35,50 L40,35 L50,65 L60,20 L65,50 L80,50" 
        stroke="white" 
        stroke-width="4" 
        fill="none" 
        stroke-linecap="round" 
        stroke-linejoin="round"/>
  
  <!-- Plus sign -->
  <rect x="42" y="72" width="16" height="4" fill="white" rx="2" ry="2" />
  <rect x="48" y="66" width="4" height="16" fill="white" rx="2" ry="2" />
</svg>